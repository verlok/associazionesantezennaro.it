---
layout: layouts/base.njk
title: Contatti
---
<div class="page-container">
  <div class="container">
    <h1 class="page-title">Scrivici</h1>
    
    <div class="contacts-grid">
      <div class="rich-content" style="margin: 0;">
        <h2>Invia un messaggio</h2>
        <p>Utilizza questo modulo per richiedere informazioni generali sulle nostre attività. Ti risponderemo al più presto.</p>
        
        <!-- Netlify Forms configuration -->
        <form name="contatti" method="POST" data-netlify="true" action="/grazie/">
          <!-- Hidden input required for Netlify Forms to process POST request correctly -->
          <input type="hidden" name="form-name" value="contatti">
          
          <div class="form-group">
            <label class="form-label" for="name">Nome e Cognome *</label>
            <input class="form-input" type="text" id="name" name="name" required placeholder="Inserisci il tuo nome">
          </div>
          
          <div class="form-group">
            <label class="form-label" for="email">Indirizzo Email *</label>
            <input class="form-input" type="email" id="email" name="email" required placeholder="latua@email.com">
          </div>
          
          <div class="form-group">
            <label class="form-label" for="message">Testo del messaggio *</label>
            <textarea class="form-textarea" id="message" name="message" rows="6" required placeholder="Come possiamo aiutarti?"></textarea>
          </div>
          
          <button type="submit" class="btn btn-primary">Invia Messaggio</button>
        </form>
      </div>
      
      <div>
        <div class="rich-content" style="background: var(--primary-light); border-color: rgba(98,191,124,0.3); margin: 0;">
          <h3 style="margin-top: 0;">Associazione Sante Zennaro</h3>
          <p>Sede operativa e contatti diretti:</p>
          
          <ul class="contact-info-list">
            <li class="contact-info-item">
              <!-- Location Icon -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span>Via Pirandello 12, Imola (BO)</span>
            </li>
            <li class="contact-info-item">
              <!-- Email Icon -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              <a href="mailto:{{ site.email }}">{{ site.email }}</a>
            </li>
            <li class="contact-info-item">
              <!-- FB Icon -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              <a href="https://www.facebook.com/ass.santezennaro.imolaic5/" target="_blank" rel="noopener">Seguici su Facebook<span class="visually-hidden"> (apre in una nuova scheda)</span></a>
            </li>
          </ul>
          
          <div style="margin-top: 2rem; border-top: 1px solid rgba(98,191,124,0.2); padding-top: 1.5rem; font-size: 0.95rem;">
            <p><strong>Cerchi altri moduli?</strong><br>Per iscriverti all'Associazione, trovi la modulistica nella sezione <a href="/associati/">Associati</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
