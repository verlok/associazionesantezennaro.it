<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="format-detection" content="telephone=no">
  <title>{{ title }} | {{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  
  <!-- SEO Meta Tags -->
  <meta property="og:title" content="{{ title }} | {{ site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ page.url }}">
  {% if image %}
    <meta property="og:image" content="{{ image }}">
  {% endif %}

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/assets/css/styles.css">
</head>
<body>
  <!-- Accessible Skip Link -->
  <a href="#content" class="skip-link">Salta al contenuto principale</a>

  <!-- Premium Glassmorphic Header -->
  <header class="site-header">
    <div class="container header-container">
      <a href="/" class="logo-link" id="logo" aria-label="Associazione Sante Zennaro Imola - Home">
        <div class="logo-content">
          <div class="logo-text">
            <span class="logo-prefix">Associazione</span>
            <span class="logo-title">Sante Zennaro</span>
            <span class="logo-suffix">Imola</span>
          </div>
          <div class="logo-graphics" aria-hidden="true">
            <img src="/assets/images/albero-bambino.png" class="logo-tree tree-sm" alt="" />
            <img src="/assets/images/albero-bambino.png" class="logo-tree tree-md" alt="" />
            <img src="/assets/images/albero-bambino.png" class="logo-tree tree-lg" alt="" />
          </div>
        </div>
      </a>
      
      <!-- Navigation Loop -->
      <nav aria-label="Navigazione principale">
        <ul class="main-nav" id="nav-menu">
          {% for item in site.navigation %}
            <li>
              <a href="{{ item.url }}" class="nav-link{% if page.url == item.url %} active{% endif %}"{% if page.url == item.url %} aria-current="page"{% endif %}><span class="nav-link-text">{{ item.text }}</span></a>
            </li>
          {% endfor %}
        </ul>
      </nav>

      <!-- Hamburger Menu for Mobile -->
      <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu" onclick="toggleMenu()">
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </header>

  <!-- Dynamic Content Injector -->
  <main id="content" tabindex="-1">
    {{ content | safe }}
  </main>

  <!-- Brand Footer -->
  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-widget">
        <h3>{{ site.title }}</h3>
        <p>{{ site.description }}</p>
      </div>
      <div class="footer-widget">
        <h3>Menu</h3>
        <ul class="footer-links">
          {% for item in site.navigation %}
            <li><a href="{{ item.url }}">{{ item.text }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div class="footer-widget">
        <h3>Contatti</h3>
        <ul class="footer-links">
          <li>Email: <a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li>Sede: {{ site.address }}</li>
          <li>C.F.: 90052230373<button class="copy-btn" data-copy="90052230373" title="Copia Codice Fiscale" aria-label="Copia Codice Fiscale"><svg class="copy-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><svg class="check-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><polyline points="20 6 9 17 4 12"></polyline></svg></button></li>
          <li>IBAN: <span class="iban-container"><span class="iban-part">IT</span><span class="iban-part">39</span><span class="iban-part">K</span><span class="iban-part">05080</span><span class="iban-part">21006</span><span class="iban-part">CC0060648980</span></span><button class="copy-btn" data-copy="IT39K0508021006CC0060648980" title="Copia IBAN" aria-label="Copia IBAN"><svg class="copy-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><svg class="check-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><polyline points="20 6 9 17 4 12"></polyline></svg></button></li>
          <li>Banca: {{ site.bank }}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {% year %} {{ site.title }} | Associazione di Promozione Sociale. Tutti i diritti riservati.</p>
    </div>
  </footer>

  <script>
    function toggleMenu() {
      const menu = document.getElementById('nav-menu');
      const button = document.querySelector('.nav-toggle');
      const isOpen = menu.classList.toggle('open');
      button.setAttribute('aria-expanded', isOpen);
    }

    // Copy button functionality with fallback for non-HTTPS/insecure contexts (like Safari local testing)
    function executeCopy(text, onSuccess, onError) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(onSuccess).catch(err => {
          fallbackCopy(text, onSuccess, onError);
        });
      } else {
        fallbackCopy(text, onSuccess, onError);
      }
    }

    function fallbackCopy(text, onSuccess, onError) {
      try {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.top = '0';
        textArea.style.left = '0';
        textArea.style.opacity = '0';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        const successful = document.execCommand('copy');
        document.body.removeChild(textArea);
        if (successful) {
          onSuccess();
        } else {
          onError(new Error('execCommand copy failed'));
        }
      } catch (err) {
        onError(err);
      }
    }

    document.querySelectorAll('.copy-btn').forEach(button => {
      button.addEventListener('click', () => {
        const textToCopy = button.getAttribute('data-copy');
        
        executeCopy(textToCopy, () => {
          const copyIcon = button.querySelector('.copy-icon');
          const checkIcon = button.querySelector('.check-icon');
          
          copyIcon.style.display = 'none';
          checkIcon.style.display = 'inline-block';
          button.classList.add('copied');
          
          setTimeout(() => {
            copyIcon.style.display = 'inline-block';
            checkIcon.style.display = 'none';
            button.classList.remove('copied');
          }, 2000);
        }, (err) => {
          console.error('Failed to copy: ', err);
        });
      });
    });
  </script>
</body>
</html>
